{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReviewDb": "Host=localhost;Port=5432;Database=review_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "AutoCreate": true
  },
  "Auth": {
    "Mode": "Jwt",
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "RequireHttpsMetadata": true,
    "ReviewerRole": "reviewer",
    "AdminRole": "admin"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "review-service",
    "ConsumerGroupId": "review-service",
    "ReviewRequestedTopic": "review.requested.v1",
    "ReviewCompletedTopic": "review.completed.v1",
    "EnsureTopics": true,
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1
  },
  "Events": {
    "Source": "/horica/review-service"
  },
  "Swagger": {
    "Enabled": false
  }
}
